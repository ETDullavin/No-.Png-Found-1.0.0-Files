{
    "format_version": "1.16.100",
    "minecraft:entity": {
        "description": {
            "identifier": "no_png:pink_man",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "no_png:despawn_timer_group": {
                "minecraft:timer": {
                    "time": 0.1,
                    "looping": false,
                    "time_down_event": {
                        "event": "no_png:execute_despawn"
                    }
                }
            },
            "no_png:instant_despawn_group": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:timer": {
                "time": 30,
                "looping": false,
                "time_down_event": {
                    "event": "no_png:execute_despawn"
                }
            },
            "minecraft:health": {
                "value": 20,
                "max": 20
            },
            "minecraft:type_family": {
                "family": [
                    "mob"
                ]
            },
            "minecraft:follow_range": {
                "value": 128,
                "max": 128
            },
            "minecraft:behavior.look_at_player": {
                "priority": 2,
                "look_distance": 128.0,
                "probability": 1.0
            },
            "minecraft:physics": {
                "has_gravity": true,
                "has_collision": true
            },
            "minecraft:pushable": {
                "is_pushable": true
            },
            "minecraft:push_through": {
                "value": 1
            },
            "minecraft:movement": {
                "value": 0.25
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:navigation.walk": {
                "avoid_water": false
            },
            "minecraft:behavior.random_stroll": {
                "priority": 6,
                "speed_multiplier": 0.8
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/null.json"
            },
            "minecraft:attack": {
                "damage": 1
            },
            "minecraft:behavior.melee_attack": {
                "priority": 1,
                "speed_multiplier": 1.34,
                "reach_multiplier": 1.0,
                "track_target": true,
                "on_attack": {
                    "event": "no_png:despawn_event",
                    "target": "self"
                }
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 2
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 1,
                "must_see": false,
                "reselect_targets": true,
                "within_radius": 128.0,
                "entity_types": [
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        "max_dist": 128.0
                    }
                ]
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "fall",
                    "deals_damage": false
                }
            }
        },
        "events": {
            "no_png:despawn_event": {
                "randomize": [
                    {
                        "weight": 1,
                        "queue_command": {
                            "command": [
                                "particle no_png:missing_particle ~ ~ ~",
                                "playsound mob.dont_look.hit @a ~ ~ ~"
                            ]
                        },
                        "add": {
                            "component_groups": [
                                "no_png:despawn_timer_group"
                            ]
                        }
                    },
                    {
                        "weight": 1,
                        "queue_command": {
                            "command": [
                                "particle no_png:missing_particle ~ ~ ~",
                                "playsound mob.corruption.hurt @a ~ ~ ~"
                            ]
                        },
                        "add": {
                            "component_groups": [
                                "no_png:despawn_timer_group"
                            ]
                        }
                    },
                    {
                        "weight": 1,
                        "queue_command": {
                            "command": [
                                "particle no_png:missing_particle ~ ~ ~",
                                "playsound mob.corruption.hurt @a ~ ~ ~"
                            ]
                        },
                        "add": {
                            "component_groups": [
                                "no_png:despawn_timer_group"
                            ]
                        }
                    }
                ]
            },
            "no_png:execute_despawn": {
                "add": {
                    "component_groups": [
                        "no_png:instant_despawn_group"
                    ]
                }
            }
        }
    }
}